---
/** Übersicht aller Inschriften als Tafeln. */
import Basis from '../../layouts/Basis.astro';
import { alleInschriften } from '../../lib/daten';
import { ART_LABEL, GRUPPEN, gruppeVon, datierungText, url } from '../../lib/konstanten';

const liste = await alleInschriften();
---
<Basis titel="Natpisi" aktiv="natpisi">
  <div class="seite">
    <header class="uvod">
      <div class="label">Arhiv</div>
      <h1>Svi natpisi</h1>
      <p>{liste.length} {liste.length === 1 ? 'zapis' : 'zapisa'} · poredano po datumu unosa</p>
    </header>

    <ul class="mreza">
      {liste.map((e) => {
        const d = e.data;
        const g = GRUPPEN[gruppeVon(d.art)];
        const foto = d.fotos[0];
        return (
          <li>
            <a class="kartica" href={url(`natpisi/${e.id}/`)}>
              <div class="luk">
                {foto ? <img src={url(`fotos/${foto.datei}`)} alt={foto.alt} loading="lazy" />
                      : <div class="luk-prazno musebak"><span class="talik" lang="ar">{d.zeilen[0].original}</span></div>}
              </div>
              <span class="label" style={`color:${g.text}`}>{ART_LABEL[d.art]}</span>
              <span class="naslov">{d.titel.bs}</span>
              <span class="mjesto">{d.ort.stadt} · {datierungText(d.datierung)}</span>
              {d.status === 'beispiel' && <span class="primjer">primjer</span>}
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</Basis>

<style>
  .seite { padding: 40px var(--rand) 0; display: flex; flex-direction: column; gap: 32px; }
  .uvod h1 { font-size: clamp(42px, 6vw, 72px); }
  .uvod p { margin: 6px 0 0; color: var(--text-2); }
  .mreza { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 36px 28px; }
  .kartica { display: flex; flex-direction: column; gap: 8px; text-decoration: none; color: var(--murekkep); position: relative; }
  .kartica:hover .naslov { color: var(--lapis); }
  .luk {
    aspect-ratio: 5 / 4; overflow: hidden; background: var(--ahar);
    clip-path: polygon(0 100%, 0 38%, 6% 22%, 18% 9%, 33% 2%, 50% 0, 67% 2%, 82% 9%, 94% 22%, 100% 38%, 100% 100%);
  }
  .luk img { width: 100%; height: 100%; object-fit: cover; transition: transform .4s; }
  .kartica:hover .luk img { transform: scale(1.04); }
  .luk-prazno { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; padding: 30px 20px 10px; }
  .luk-prazno span {
    background: var(--krec); padding: 4px 18px 0; border-radius: 30px; font-size: 19px;
    max-width: 90%; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .naslov { font-family: var(--f-titel); font-size: 25px; font-weight: 600; line-height: 1.1; }
  .mjesto { font-size: 16px; color: var(--text-2); }
  .primjer { position: absolute; top: 46px; right: 10px; background: var(--ahar-hell); border: 1px solid var(--varak); padding: 1px 8px; font-size: 13px; }
</style>
