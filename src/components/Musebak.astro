---
/** Mušebak-Ladezustand: Licht fällt durch ein Holzgitter. */
interface Props { text?: string; variante?: 'seite' | 'bild' | 'karte' }
const { text = 'Učitavanje …', variante = 'seite' } = Astro.props;
---
<div class:list={['musebak-laden', `musebak-laden--${variante}`]} role="status" aria-live="polite">
  {variante === 'bild' ? (
    <>
      <div class="licht"></div>
      <div class="gitter"></div>
    </>
  ) : (
    <div class="schatten"></div>
  )}
  <div class="inhalt">
    <span class="talik ornament" aria-hidden="true">کتابه</span>
    <span class="text">{text}</span>
  </div>
</div>

<style>
  .musebak-laden { position: absolute; inset: 0; overflow: hidden; background: var(--krec); z-index: 5; display: flex; align-items: center; justify-content: center; }
  .musebak-laden--karte { background: #F6EEDB; }
  .schatten {
    position: absolute; inset: -60px -120px;
    background-image:
      repeating-linear-gradient(45deg, rgba(58,37,25,.13) 0 10px, transparent 10px 34px),
      repeating-linear-gradient(-45deg, rgba(58,37,25,.13) 0 10px, transparent 10px 34px);
    animation: wandern 9s ease-in-out infinite;
  }
  .licht {
    position: absolute; inset: 0;
    background: linear-gradient(110deg, var(--orah) 0%, var(--orah) 38%, #F6E7C1 50%, var(--orah) 62%, var(--orah) 100%);
    background-size: 300% 100%;
    animation: licht 2.8s linear infinite;
  }
  .gitter {
    position: absolute; inset: 0;
    background-image:
      repeating-linear-gradient(45deg, var(--orah) 0 7px, transparent 7px 26px),
      repeating-linear-gradient(-45deg, var(--orah) 0 7px, transparent 7px 26px);
  }
  .inhalt { position: relative; display: flex; flex-direction: column; align-items: center; gap: 2px; }
  .musebak-laden--bild .inhalt { display: none; }
  .ornament { font-size: 34px; color: var(--varak); animation: atmen 2.4s ease-in-out infinite; }
  .text { font-size: 18px; color: var(--text-2); }
  @keyframes wandern { 0%,100% { transform: skewX(-18deg) translateX(-40px); } 50% { transform: skewX(-18deg) translateX(40px); } }
  @keyframes licht { 0% { background-position: 100% 0; } 100% { background-position: 0% 0; } }
  @keyframes atmen { 0%,100% { opacity: .35; } 50% { opacity: .85; } }
</style>
